generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

model Project {
  id                  String   @id @default(cuid())
  userId              String   
  title               String
  description         String?
  projectType         String   @default("single")
  numberOfAssignments Int?
  tags                String?
  link                String?  
  createdAt           DateTime @default(now())
}